<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- 어노테이션 기반 MVC 활성화.
         jackson-databind가 클래스패스에 있으면 JSON 메시지 컨버터를 자동 등록한다.
         → 별도 뷰리졸버(JSP 등) 없이 @RestController 반환값이 JSON으로 나간다. -->
    <mvc:annotation-driven/>

    <context:property-placeholder location="classpath:db.properties"/>

    <!-- CORS 전역 설정. 프론트(Vue 개발서버)는 다른 오리진(포트)이라 브라우저가 교차 출처 요청을
         막는데, 여기서 허용 오리진을 명시해 풀어준다.
         allowed-headers="*" 로 JWT의 Authorization 헤더까지 허용해야 토큰 요청의 preflight가 통과한다.
         allow-credentials="true" 를 쓰면 allowed-origins 에 "*" 를 못 쓰므로 오리진을 명시한다.
         운영 배포 시에는 localhost:5173 을 실제 프론트 도메인으로 바꾼다. -->
    <mvc:cors>
        <mvc:mapping path="/api/**"
                     allowed-origins="${app.cors.allowed-origin:http://localhost:5173}"
                     allowed-methods="GET,POST,PUT,PATCH,DELETE,OPTIONS"
                     allowed-headers="*"
                     allow-credentials="true"/>
    </mvc:cors>

    <!-- 컨트롤러만 스캔 (서비스 계층은 root-context가 담당).
         use-default-filters=false + @Controller 포함 → @RestController도 함께 등록됨. -->
    <context:component-scan base-package="com.wallet" use-default-filters="false">
        <context:include-filter type="annotation"
                                expression="org.springframework.stereotype.Controller"/>
    </context:component-scan>

    <!-- 카드/이미지 정적 리소스 매핑.
         location을 "file:" 접두사로 주면 WAR/classpath 내부가 아닌
         서버의 실제 파일시스템 경로에서 파일을 읽어 서빙한다.
         → 재배포(WAR 재생성)해도 이미지가 사라지지 않는다.
         경로는 db.properties의 app.image.storage-path 값을 사용하며,
         값 끝에 반드시 슬래시가 오도록 뒤에 "/"를 붙여준다. -->
    <mvc:resources mapping="/images/**" location="/resources/images/"/>
</beans>