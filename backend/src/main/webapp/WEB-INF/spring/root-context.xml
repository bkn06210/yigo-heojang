<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:task="http://www.springframework.org/schema/task"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd
           http://www.springframework.org/schema/task
           http://www.springframework.org/schema/task/spring-task.xsd">

    <!-- DB 접속값은 코드/설정에 직접 쓰지 않고 db.properties에서 읽어 ${...}로 참조.
         db.properties는 .gitignore로 제외, db.properties.example를 복사해 채운다. + redis.properties -->
    <context:property-placeholder location="classpath:db.properties,classpath:redis.properties"/>

    <!-- 서비스 계층 컴포넌트 스캔 (컨트롤러는 제외 → servlet-context가 담당).
         @RestController는 @Controller를 메타 포함하므로 함께 제외된다. -->
    <context:component-scan base-package="com.wallet">
        <context:exclude-filter type="annotation"
                                expression="org.springframework.stereotype.Controller"/>
    </context:component-scan>

    <!-- HikariCP DataSource: setter 방식으로 선언 → 커넥션 풀이 '첫 쿼리 시점'에 생성(지연 초기화).
         덕분에 MySQL이 꺼져 있어도 컨텍스트가 기동하고 헬스체크가 동작한다. -->
    <bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="${db.driver}"/>
        <property name="jdbcUrl" value="${db.url}"/>
        <property name="username" value="${db.username}"/>
        <property name="password" value="${db.password}"/>
    </bean>

    <!-- MyBatis SqlSessionFactory: snake_case DB 컬럼 → camelCase 자바 필드 자동 매핑 -->
    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="dataSource"/>
        <property name="configuration">
            <bean class="org.apache.ibatis.session.Configuration">
                <property name="mapUnderscoreToCamelCase" value="true"/>
            </bean>
        </property>
        <!-- 매퍼 XML 위치 (아직 없음, 다음 단계에서 추가) -->
        <property name="mapperLocations" value="classpath*:mappers/**/*.xml"/>
    </bean>

    <!-- 매퍼 인터페이스 자동 스캔·등록 — 두 방식을 모두 허용한다(파트별 컨벤션 차이 수용).
         (1) 패키지가 *.mapper 이면 등록(애노테이션 불필요)  (2) 위치와 무관하게 @Mapper가 붙었으면 등록.
         basePackage만 com.wallet로 두면 매퍼 아닌 인터페이스까지 가짜 매퍼 빈이 되므로 두 스캐너 모두
         범위를 좁혀 둔다. 두 조건에 다 걸리는 매퍼는 MyBatis가 중복 등록을 건너뛴다. -->
    <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="com.wallet"/>
        <property name="annotationClass" value="org.apache.ibatis.annotations.Mapper"/>
        <property name="sqlSessionFactoryBeanName" value="sqlSessionFactory"/>
    </bean>

    <!-- 트랜잭션: @Transactional 활성화 -->
    <bean id="transactionManager"
          class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="dataSource"/>
    </bean>
    <tx:annotation-driven transaction-manager="transactionManager"/>

    <!-- 비밀번호 해시/검증 -->
    <bean id="passwordEncoder"
          class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder">
    </bean>

    <!-- ObjectMapper -->
    <bean id="objectMapper"
          class="com.fasterxml.jackson.databind.ObjectMapper">
    </bean>

    <!-- JavaMailSenderImpl -->
    <bean id="mailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
        <property name="host" value="${mail.host}"/>
        <property name="port" value="${mail.port}"/>
        <property name="username" value="${mail.username}"/>
        <property name="password" value="${mail.password}"/>
        <property name="defaultEncoding" value="UTF-8"/>
        <property name="javaMailProperties">
            <props>
                <prop key="mail.smtp.auth">${mail.smtp.auth}</prop>
                <prop key="mail.smtp.starttls.enable">${mail.smtp.starttls.enable}</prop>
                <prop key="mail.smtp.connectiontimeout">${mail.smtp.connectiontimeout}</prop>
                <prop key="mail.smtp.timeout">${mail.smtp.timeout}</prop>
                <prop key="mail.smtp.writetimeout">${mail.smtp.writetimeout}</prop>
                <prop key="mail.debug">${mail.debug}</prop>
            </props>
        </property>
    </bean>

    <!-- Redis 커넥션 풀 설정 -->
    <bean id="jedisPoolConfig" class="redis.clients.jedis.JedisPoolConfig">
        <property name="maxTotal" value="${redis.pool.max-total}"/>
        <property name="maxIdle" value="${redis.pool.max-idle}"/>
        <property name="minIdle" value="${redis.pool.min-idle}"/>
    </bean>

    <!-- Redis 커넥션 풀. HikariDataSource와 마찬가지로 destroy-method="close"로
         애플리케이션 종료 시 커넥션을 정리한다. -->
    <bean id="jedisPool" class="redis.clients.jedis.JedisPool" destroy-method="close">
        <constructor-arg ref="jedisPoolConfig"/>
        <constructor-arg value="${redis.host}"/>
        <constructor-arg value="${redis.port}" type="int"/>
        <constructor-arg value="${redis.timeout-millis}" type="int"/>
        <constructor-arg value="${redis.password}"/>
    </bean>

    <!-- @Scheduled 처리기. pool-size는 동시에 실행될 수 있는 배치 개수(실적 부족·혜택 한도 등)만큼
     넉넉히 잡아둔다 — 하나가 오래 걸려도 다른 배치가 그 뒤에서 대기하지 않도록. -->
    <task:scheduler id="notificationTaskScheduler" pool-size="4"/>
    <task:annotation-driven scheduler="notificationTaskScheduler"/>

    <!-- 챗봇 서버(별도 프로세스) 호출용 RestTemplate.
         readTimeout이 긴 것은 답변 생성에 LLM 호출이 들어가 수 초 걸리기 때문이다.
         챗봇이 이 서버의 엔진 API를 되부를 때 쓰는 타임아웃보다 반드시 길어야 한다 —
         짧으면 안쪽 조회가 아직 도는데 바깥이 먼저 끊어져 매번 실패로 보인다. -->
    <bean id="chatbotRequestFactory"
          class="org.springframework.http.client.SimpleClientHttpRequestFactory">
        <property name="connectTimeout" value="2000"/>
        <property name="readTimeout" value="30000"/>
    </bean>

    <bean id="restTemplate" class="org.springframework.web.client.RestTemplate">
        <constructor-arg ref="chatbotRequestFactory"/>
    </bean>

</beans>
