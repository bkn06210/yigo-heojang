# Redis 접속 정보. 실제 값은 redis.properties에 넣고 커밋하지 않는다(.gitignore 처리).
# 로컬 개발 시 이 파일을 복사해 redis.properties로 저장한 뒤 값을 채운다.
redis.host=localhost
redis.port=6379
redis.password=your_password_here
redis.timeout-millis=2000

# 커넥션 풀 설정
redis.pool.max-total=16
redis.pool.max-idle=8
redis.pool.min-idle=2

# 안 읽은 알림 수 캐시 TTL(초)
redis.unread-count.ttl-seconds=3600

# 일 배치 분산 락 TTL(초) — 다음 커밋(스케줄러)에서 사용.
# 정상적인 최대 배치 시간보다 넉넉히 길게 잡는다(규칙 문서 6.1절).
redis.lock.ttl-seconds=600