<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wallet.auth.mapper.TermAgreementMapper">
    <!--
        요청으로 들어온 termsVersionId 중
        현재 회원가입에 사용할 수 있는 약관 버전 개수를 조회한다.

        조건 설명:
        - term_status = 'ACTIVE': 활성화된 약관만 허용
        - effective_started_at <= NOW(): 이미 시행된 약관만 허용
        - effective_ended_at IS NULL OR effective_ended_at > NOW(): 아직 종료되지 않은 약관만 허용

        서비스에서는 요청한 ID 개수와 이 쿼리 결과를 비교해서
        유효하지 않은 약관 버전 ID가 포함되었는지 판단한다.
    -->
    <select id="countActiveTermVersionsByIds" resultType="int">
        SELECT COUNT(*)
        FROM term_version tv
        INNER JOIN term t ON tv.term_id = t.term_id
        WHERE t.term_status = 'ACTIVE'
        <![CDATA[
          AND tv.effective_started_at <= NOW()
          AND (
            tv.effective_ended_at IS NULL
                OR tv.effective_ended_at > NOW()
          )
        ]]>
          AND tv.term_version_id IN
        <foreach collection="termsVersionIds" item="termsVersionId"  open="("  separator=","  close=")">
            #{termsVersionId}
        </foreach>
    </select>

    <!--
        현재 활성화된 필수 약관의 최신 유효 버전 ID를 조회한다.

        is_required = 1:
        - 반드시 동의해야 하는 약관이라는 의미다.

        회원가입 서비스에서는 이 결과가 모두 agreed=true로 들어왔는지 확인한다.
    -->
    <select id="findActiveRequiredTermVersionIds" resultType="long">
        SELECT tv.term_version_id
        FROM term_version tv
        INNER JOIN term t ON tv.term_id = t.term_id
        WHERE t.term_status = 'ACTIVE'
          AND t.is_required = 1
        <![CDATA[
          AND tv.effective_started_at <= NOW()
          AND (
              tv.effective_ended_at IS NULL
              OR tv.effective_ended_at > NOW()
          )
        ]]>
    </select>

    <!--
        회원의 약관 동의 이력을 한 번에 저장한다.

        foreach:
        - List<MemberTermAgreement>를 반복하면서 여러 VALUES 묶음을 만든다.
        - 약관이 3개라면 INSERT 한 번으로 3행을 저장할 수 있다.

        agreed_at:
        - 동의한 약관이면 CURRENT_TIMESTAMP를 저장한다.
        - 동의하지 않은 선택 약관이면 NULL을 저장한다.
    -->
    <insert id="insertMemberTermAgreements">
        INSERT INTO member_term_agreement (
        member_id,
        term_version_id,
        is_agreed,
        agreed_at
        )
        VALUES
        <foreach collection="agreements" item="agreement" separator=",">
            (
                #{agreement.memberId},
                #{agreement.termsVersionId},
                #{agreement.agreed},
                CASE
                    WHEN #{agreement.agreed} = TRUE THEN CURRENT_TIMESTAMP
                    ELSE NULL
                END
            )
        </foreach>
    </insert>
</mapper>