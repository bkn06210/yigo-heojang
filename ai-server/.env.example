# ai-server/.env 로 복사해 값을 채운다. .env 는 저장소에 올라가지 않는다.
# API 키는 이 파일에도, 코드에도, 캡처에도 넣지 않는다.

# --- 수집 파이프라인 (ingest) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet
DB_USER=root
DB_PASSWORD=

# --- 챗봇 서버 (chatbot) ---
# stub = LLM 을 부르지 않는 개발용. openai = 실제 호출.
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 엔진 계산값을 받아올 곳. 금액 계산은 챗봇이 하지 않는다.
BACKEND_BASE_URL=http://localhost:8080/wallet

# Spring 경유로만 호출받으므로 외부에 열지 않는다.
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8000
