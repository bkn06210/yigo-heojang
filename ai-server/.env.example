# ai-server/.env 로 복사해 값을 채운다. .env 는 저장소에 올라가지 않는다.
# API 키는 이 파일에도, 코드에도, 캡처에도 넣지 않는다.

# --- 수집 파이프라인 (ingest) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wallet
DB_USER=root
DB_PASSWORD=

# --- 챗봇 서버 (chatbot) ---
# stub = LLM 을 부르지 않는 개발용. openai = 실제 호출.
LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 임베딩 (약관 검색) ---
# stub = 키 없이 도는 개발용. 글자만 보므로 뜻으로는 못 찾는다. voyage = 실제 호출.
EMBEDDING_PROVIDER=stub
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# 키를 발급받은 곳에 따라 주소가 다르다. 요청 모양은 같고 주소만 갈린다.
#   Voyage 대시보드에서 만든 키 → https://api.voyageai.com/v1/embeddings (기본값)
#   MongoDB Atlas 에서 만든 키   → https://ai.mongodb.com/v1/embeddings
EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings
# 모델이 지원하는 값만 넣는다(voyage-4-lite 는 2048/1024/512/256).
# 바꾸면 이미 만든 벡터와 좌표계가 달라져 색인을 전부 다시 만든다.
EMBEDDING_DIMENSION=1024

# 엔진 계산값을 받아올 곳. 금액 계산은 챗봇이 하지 않는다.
BACKEND_BASE_URL=http://localhost:8080

# Spring 경유로만 호출받으므로 외부에 열지 않는다.
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8000
