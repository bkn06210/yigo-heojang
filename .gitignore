# Claude Code 프로젝트 컨텍스트 (깃허브에 올리지 않음)
CLAUDE.md
.claude/

# 민감정보
application.properties
application-*.properties
db.properties
.env
.env.*
# 값이 아니라 키 목록이라 공유해야 한다.
!.env.example
*.key
*.pem

# 빌드 산출물
target/
*.war
*.class

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/


# 카드사 약관 원문 — 저작권상 레포에 올리지 않는다.
# card_term_document.source_url로 재취득 가능하고, 추출 결과는 시드 SQL로 커밋된다.
ai-server/ingest/raw/
# 추출한 약관 본문도 원문이다. DB(card_term_document)에 들어가고 파이프라인으로 재생성된다.
ai-server/ingest/out/terms/
# 공통 문구를 걷어낸 구조화 입력. 줄어들었을 뿐 여전히 약관 원문이라 같은 이유로 제외한다.
ai-server/ingest/out/pruned/
# 약관 원문 덤프 SQL(ingest.dump_terms 산출물). 형식만 바뀐 원문이라 같은 이유로 제외한다.
# 파일은 저장소가 아니라 팀 안에서 따로 주고받는다.
backend/db/local/
# 이전 회차 구조화 결과 (비교용 백업)
ai-server/ingest/out/structured_v1/
# PDF 페이지 렌더링 (중간 산출물, 재생성 가능)
ai-server/ingest/out/*.png
ai-server/ingest/out/vision/

# Frontend dependencies
frontend/node_modules/

# Frontend build output
frontend/dist/
